<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" agent="Hirely-Entrega2" version="24.0.0"><diagram name="C4 - Nivel 1 Contexto" id="page1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3" value="" style="shape=umlActor;html=1;outlineConnect=0;fillColor=none;strokeColor=#2E7D32;verticalLabelPosition=middle;" vertex="1" parent="1"><mxGeometry x="90" y="60" width="60" height="60" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Candidato que centraliza su perfil y aplica a empleos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=11;arcSize=10;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="160" height="90" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;💼 Hirely&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema de software]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Centraliza el perfil profesional del usuario e importa/autocompleta informacion en formularios de empleo (app web + extension de navegador)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="420" y="240" width="300" height="150" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;🗄 Supabase&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo (BaaS)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Autenticacion, base de datos PostgreSQL y almacenamiento de archivos." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="900" y="60" width="300" height="140" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;🤖 Google Gemini&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistema externo (IA)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Servicio de IA generativa. Extrae datos estructurados (JSON) desde el PDF del CV." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E44AD;strokeColor=#5E2F73;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="900" y="240" width="300" height="140" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;🌐 Plataformas de empleo&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Sistemas externos (pendiente)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Sitios de terceros donde el usuario aplica; la extension de navegador (a cargo de otro integrante) lee/completa sus formularios." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#7a4f10;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="420" width="300" height="140" as="geometry" /></mxCell><mxCell id="e9" value="Gestiona su perfil, importa&#10;su CV y usa la extension&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="Autentica, lee/escribe datos&#10;y sube archivos&#10;[HTTPS / PostgREST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="Envia el PDF del CV, recibe&#10;los datos extraidos en JSON&#10;[HTTPS / generateContent]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="Detecta campos y propone&#10;autocompletarlos&#10;[DOM - en desarrollo]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n13" value="Nota: colores solidos = sistemas ya integrados y verificados en el codigo real (Supabase en verde, Gemini en morado). El recuadro mostaza punteado 'Plataformas de empleo' representa la relacion de la extension de navegador con sitios externos: se deja marcado como pendiente porque su implementacion tecnica esta a cargo de otro integrante del equipo y aun no esta confirmada." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="460" width="760" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="C4 - Nivel 2 Contenedores" id="page2"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3" value="" style="shape=umlActor;html=1;outlineConnect=0;fillColor=none;strokeColor=#2E7D32;verticalLabelPosition=middle;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="60" height="60" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Persona]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Candidato" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E7D32;fontColor=#2E7D32;fontSize=11;arcSize=10;align=center;verticalAlign=middle;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="10" y="110" width="130" height="90" as="geometry" /></mxCell><mxCell id="n5" value="Hirely [limite del sistema]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=bottom;align=left;fontColor=#707070;fontSize=13;fontStyle=2;spacing=8;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="700" height="620" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;🌐 Aplicacion Web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: TanStack Start / React 19 / TypeScript]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Mi Perfil, Mi Hoja de Vida, configuracion, importar CV con IA." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n5"><mxGeometry x="40" y="40" width="280" height="160" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;🖥 Funciones de Servidor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: TanStack Start server functions]&lt;/i&gt;&lt;br&gt;&lt;br&gt;extractCvData, deleteMyAccount, auth-middleware, gemini.server.ts." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n5"><mxGeometry x="40" y="240" width="280" height="160" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;🧩 Extension de Navegador&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container: pendiente - otro integrante]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Detecta y autocompleta campos de formularios de empleo. Tecnologia y forma de obtener el perfil por confirmar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#7a4f10;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;strokeWidth=2;" vertex="1" parent="n5"><mxGeometry x="380" y="40" width="280" height="160" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;Nota&lt;/b&gt;&lt;br&gt;Como la extension obtiene los datos del perfil (Supabase directo o via la app web) queda pendiente de confirmar con el compañero a cargo." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="n5"><mxGeometry x="380" y="240" width="280" height="160" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;🔐 Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Servicio gestionado]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Correo/contraseña + Google OAuth. Sesion JWT Bearer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1020" y="40" width="280" height="130" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;🗄 Supabase Postgres&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Base de datos relacional gestionada]&lt;/i&gt;&lt;br&gt;&lt;br&gt;17 tablas de negocio, RLS por fila (owns_profile())." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1020" y="190" width="280" height="140" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;📁 Supabase Storage&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Almacenamiento de objetos]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Buckets: avatars, cvs, certificates (RLS por carpeta)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1020" y="350" width="280" height="130" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;🤖 Google Gemini API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Servicio de IA gestionado]&lt;/i&gt;&lt;br&gt;&lt;br&gt;generateContent + responseSchema (extraccion estructurada de PDF)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E44AD;strokeColor=#5E2F73;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1020" y="500" width="280" height="140" as="geometry" /></mxCell><mxCell id="e14" value="Usa&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="Usa mientras navega&#10;plataformas de empleo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n4" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="Invoca&#10;[llamada de servidor]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="Verifica sesion&#10;[HTTPS / JWT]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n6" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="Lee/escribe perfil y hoja&#10;de vida (CRUD)&#10;[HTTPS / PostgREST SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n6" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="Sube/descarga avatar&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n6" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="Descarga PDF del CV&#10;[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n7" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="Guarda extracted_data,&#10;status de cv_imports&#10;[HTTPS / PostgREST SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="Envia PDF (base64) + prompt&#10;+ responseSchema&#10;[HTTPS / REST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="Probablemente consulta el&#10;perfil guardado (por confirmar)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n8" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="C4 - Nivel 3 Componentes (Aplicacion Web)" id="page3"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3" value="Aplicacion Web [contenedor: TanStack Start / React 19]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=bottom;align=left;fontColor=#707070;fontSize=13;fontStyle=2;spacing=8;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1400" height="590" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;🔑 Rutas de Autenticacion&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: rutas TanStack Router]&lt;/i&gt;&lt;br&gt;&lt;br&gt;login, registro, recuperar, reset-password, auth.callback. Correo/contraseña + Google OAuth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="30" y="30" width="230" height="150" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;🗂 Rutas de Perfil / Hoja de Vida&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: rutas TanStack Router]&lt;/i&gt;&lt;br&gt;&lt;br&gt;app.perfil.*, app.hoja-de-vida.* -- 11 secciones de CRUD sobre CrudSection generico." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="280" y="30" width="230" height="150" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;🎨 Rutas de Configuracion&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: app.configuracion]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Tema claro/oscuro/automatico + 5 acentos predefinidos + color hex personalizado (persistido en user_preferences)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="530" y="30" width="230" height="150" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;📄 Rutas de Importar CV&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: importar-cv, revisar, revisar-importacion]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Sube PDF (&lt;=5MB) y muestra las 2 pantallas de revision (perfil y hoja de vida)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="780" y="30" width="230" height="150" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;🧩 Paginas de simulacion de Extension&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: /extension, /app/extension]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Simulan visualmente el popup de la extension con estado local de React. NO es la extension real: sin manifest.json ni content script. Boton 'Obtener paquete' aun no funcional." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#7a4f10;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;strokeWidth=2;" vertex="1" parent="n3"><mxGeometry x="1030" y="30" width="310" height="150" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;🪝 Hooks genericos&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: useRows / useSaveRow / useDeleteRow]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Patron repositorio parametrizado por tabla; reutilizado en las 11 secciones del CRUD." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="30" y="205" width="230" height="140" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;📋 CrudSection + AlertDialog&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: crud-section.tsx]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Lista, edita y borra registros; pide confirmacion con modal antes de eliminar (cumple HU2)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="280" y="205" width="230" height="140" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;📝 cv-review-list&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: cv-review-list.tsx]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Tarjeta editable por elemento detectado, con casilla de incluir/excluir y boton para quitar." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="530" y="205" width="230" height="140" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;✅ Formularios&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: react-hook-form + Zod]&lt;/i&gt;&lt;br&gt;&lt;br&gt;@hookform/resolvers -- valida los formularios en el cliente antes de enviar cualquier dato." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="780" y="205" width="230" height="140" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;🧱 Libreria de componentes UI&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: src/components/ui]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Radix UI (primitivas headless) + shadcn/ui + Tailwind CSS v4. Usada de forma transversal por todas las rutas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="1030" y="205" width="310" height="140" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;🔄 TanStack Query&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: cache de estado de servidor]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Cachea y sincroniza los datos leidos de Supabase entre pantallas." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="30" y="375" width="230" height="130" as="geometry" /></mxCell><mxCell id="n15" value="&lt;b&gt;🗄 Supabase (cliente)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: client.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Clave publica (VITE_SUPABASE_PUBLISHABLE_KEY), sujeto a RLS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="280" y="375" width="230" height="130" as="geometry" /></mxCell><mxCell id="n16" value="&lt;b&gt;🔐 Supabase Auth&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Servicio gestionado (ver Nivel 2)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Correo/contraseña + Google OAuth. Sesion JWT Bearer." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="260" height="130" as="geometry" /></mxCell><mxCell id="n17" value="&lt;b&gt;🗄 Supabase Postgres&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Base de datos (ver Nivel 2)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;17 tablas de negocio, RLS por fila." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="340" y="700" width="260" height="130" as="geometry" /></mxCell><mxCell id="n18" value="&lt;b&gt;📁 Supabase Storage&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Almacenamiento (ver Nivel 2)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Buckets: avatars, cvs, certificates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="640" y="700" width="260" height="130" as="geometry" /></mxCell><mxCell id="n19" value="&lt;b&gt;🖥 Funciones de Servidor&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container -- diagrama aparte (pestaña siguiente)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;extractCvData, deleteMyAccount y sus modulos de apoyo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="940" y="700" width="300" height="130" as="geometry" /></mxCell><mxCell id="e20" value="Login / registro directo" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n4" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="Renderiza con" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n5" target="n10"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="Usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n10" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="Cachea con" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n9" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="Lee/escribe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="Guarda preferencias" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n6" target="n15"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="Navega a" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e27" value="Guarda items marcados" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n11" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e28" value="Invoca extractCvData&#10;[llamada de servidor]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n7" target="n19"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e29" value="Valida con" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontColor=#666666;fontSize=10;" edge="1" parent="1" source="n4" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e30" value="Valida con" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontColor=#666666;fontSize=10;" edge="1" parent="1" source="n5" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e31" value="Usa" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontColor=#666666;fontSize=10;" edge="1" parent="1" source="n5" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e32" value="Usa" style="endArrow=open;dashed=1;html=1;strokeColor=#666666;fontColor=#666666;fontSize=10;" edge="1" parent="1" source="n7" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e33" value="[HTTPS / Auth SDK]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e34" value="[HTTPS / PostgREST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n15" target="n17"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e35" value="[HTTPS] (avatar)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n15" target="n18"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n36" value="&lt;b&gt;Nota&lt;/b&gt;&lt;br&gt;Este diagrama hace zoom SOLO al contenedor &quot;Aplicacion Web&quot; del Nivel 2 (front); &quot;Funciones de Servidor&quot; (back) tiene su propio diagrama en la siguiente pestaña, siguiendo la regla C4 de un diagrama de Componentes por contenedor. Las &quot;Paginas de simulacion de Extension&quot; (mostaza) son un hallazgo verificado: existen dentro de la propia app web, pero simulan el popup de la extension real -- no son el trabajo del compañero que la está construyendo aparte." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="850" width="1300" height="110" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="C4 - Nivel 3 Componentes (Funciones de Servidor)" id="page4"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3" value="Funciones de Servidor [contenedor: TanStack Start server functions]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;verticalAlign=bottom;align=left;fontColor=#707070;fontSize=13;fontStyle=2;spacing=8;container=1;collapsible=0;recursiveResize=0;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="1160" height="460" as="geometry" /></mxCell><mxCell id="n4" value="&lt;b&gt;🔒 auth-middleware&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: auth-middleware.ts (requireSupabaseAuth)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Valida el Bearer JWT antes de dejar pasar la peticion a cualquier funcion de servidor." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="30" y="30" width="260" height="150" as="geometry" /></mxCell><mxCell id="n5" value="&lt;b&gt;⚙ extractCvData&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: cv-import.functions.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Orquesta la extraccion: descarga el PDF, llama a Gemini, valida el JSON y guarda el resultado." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="320" y="30" width="260" height="150" as="geometry" /></mxCell><mxCell id="n6" value="&lt;b&gt;🗑 deleteMyAccount&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: funcion de servidor]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Borra archivos de Storage (avatars/cvs/certificates), filas de perfil y el usuario de Auth." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="610" y="30" width="260" height="150" as="geometry" /></mxCell><mxCell id="n7" value="&lt;b&gt;🤖 Cliente Gemini&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: gemini.server.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Arma el prompt + responseSchema. Modelo configurado: gemini-3.6-flash. Reintento ante 503/429 con backoff." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E44AD;strokeColor=#5E2F73;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="30" y="205" width="260" height="150" as="geometry" /></mxCell><mxCell id="n8" value="&lt;b&gt;✅ Validador Zod&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: cv-import.schema.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Valida el JSON devuelto por Gemini contra el esquema esperado antes de guardarlo." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="320" y="205" width="260" height="150" as="geometry" /></mxCell><mxCell id="n9" value="&lt;b&gt;🗝 Supabase (servidor)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Component: client.server.ts]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Service role key -- bypassa RLS. Solo se usa dentro de funciones de servidor confiables." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="n3"><mxGeometry x="610" y="205" width="260" height="150" as="geometry" /></mxCell><mxCell id="n10" value="&lt;b&gt;🌐 Aplicacion Web&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Container -- diagrama aparte (pestaña anterior)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Invoca estas funciones de servidor desde las rutas de Importar CV." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1168BD;strokeColor=#0B4884;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="280" height="130" as="geometry" /></mxCell><mxCell id="n11" value="&lt;b&gt;🗄 Supabase Postgres&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Base de datos (ver Nivel 2)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;17 tablas de negocio -- accedidas aqui con service role, bypassa RLS." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="350" y="620" width="260" height="130" as="geometry" /></mxCell><mxCell id="n12" value="&lt;b&gt;📁 Supabase Storage&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Almacenamiento (ver Nivel 2)]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Buckets: avatars, cvs, certificates." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="640" y="620" width="260" height="130" as="geometry" /></mxCell><mxCell id="n13" value="&lt;b&gt;🔐 Supabase Auth (Admin API)&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Servicio gestionado]&lt;/i&gt;&lt;br&gt;&lt;br&gt;Usada por deleteMyAccount para borrar el usuario (cliente admin, service role)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E8B57;strokeColor=#1F5C3A;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="930" y="620" width="260" height="130" as="geometry" /></mxCell><mxCell id="n14" value="&lt;b&gt;🤖 Google Gemini API&lt;/b&gt;&lt;br&gt;&lt;i&gt;[Servicio de IA gestionado]&lt;/i&gt;&lt;br&gt;&lt;br&gt;generateContent + responseSchema (extraccion estructurada de PDF)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#8E44AD;strokeColor=#5E2F73;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;" vertex="1" parent="1"><mxGeometry x="1230" y="620" width="260" height="130" as="geometry" /></mxCell><mxCell id="e15" value="Invoca&#10;[llamada de servidor]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n10" target="n4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="Autoriza y continua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="Autoriza y continua" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n4" target="n6"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="Descarga PDF&#10;[Storage]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="Usa" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n5" target="n7"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="Valida JSON con" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n5" target="n8"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="Guarda extracted_data,&#10;status de cv_imports&#10;[PostgREST]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n5" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="[HTTPS / generateContent]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n7" target="n14"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e23" value="Usa (borra archivos,&#10;filas y usuario)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;" edge="1" parent="1" source="n6" target="n9"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="[PostgREST -- bypassa RLS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n9" target="n11"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e25" value="[HTTPS]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n9" target="n12"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e26" value="[Admin API]" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=open;endFill=1;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#707070;fontColor=#333333;dashed=1;" edge="1" parent="1" source="n9" target="n13"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="n27" value="&lt;b&gt;Nota&lt;/b&gt;&lt;br&gt;Este diagrama hace zoom SOLO al contenedor &quot;Funciones de Servidor&quot; del Nivel 2 (back); &quot;Aplicacion Web&quot; (front) tiene su propio diagrama en la pestaña anterior. Dos puntos quedan marcados como pendientes, sin inventar el detalle: (1) no esta confirmado en el codigo revisado si auth-middleware valida el JWT de forma local o llamando a Supabase Auth, por eso no se dibuja esa flecha; (2) la funcion logActivity (bitacora registrada en casi todas las mutaciones, ver hallazgos-tecnicos-hirely-09.md seccion 4) no aparece aqui porque no esta confirmado en que capa vive (cliente o funcion de servidor)." style="shape=note;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1"><mxGeometry x="40" y="780" width="1450" height="130" as="geometry" /></mxCell></root></mxGraphModel></diagram><diagram name="Vista comportamental - Secuencia Importar CV" id="page5"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3" value="Usuario" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e4" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="90" as="sourcePoint" /><mxPoint x="125" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n5" value="Ruta /importar-cv&#10;(cliente)" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="220" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e6" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="90" as="sourcePoint" /><mxPoint x="305" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n7" value="Supabase&#10;Storage (cvs)" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e8" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="505" y="90" as="sourcePoint" /><mxPoint x="505" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n9" value="Base de datos&#10;(resumes / cv_imports)" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="620" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e10" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="705" y="90" as="sourcePoint" /><mxPoint x="705" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n11" value="Server Function&#10;extractCvData" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="860" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e12" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="90" as="sourcePoint" /><mxPoint x="945" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n13" value="Gemini API" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1080" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e14" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1165" y="90" as="sourcePoint" /><mxPoint x="1165" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="n15" value="Pantalla revision&#10;Perfil / Hoja de vida" style="html=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;verticalAlign=top;fontStyle=1;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="40" width="170" height="50" as="geometry" /></mxCell><mxCell id="e16" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#6c8ebf;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="90" as="sourcePoint" /><mxPoint x="1365" y="900" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e17" value="1. Sube PDF (&lt;=5MB)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="140" as="sourcePoint" /><mxPoint x="305" y="140" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e18" value="2. Sube archivo a bucket 'cvs'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="198" as="sourcePoint" /><mxPoint x="505" y="198" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e19" value="3. Crea fila en 'resumes' y&#10;'cv_imports' (status: processing)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="256" as="sourcePoint" /><mxPoint x="705" y="256" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e20" value="4. Invoca extraccion" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="314" as="sourcePoint" /><mxPoint x="945" y="314" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e21" value="5. Descarga PDF y lo&#10;codifica en base64" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="372" as="sourcePoint" /><mxPoint x="505" y="372" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e22" value="6. generateContent(PDF +&#10;prompt + responseSchema)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="430" as="sourcePoint" /><mxPoint x="1165" y="430" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e23" value="7. JSON estructurado&#10;(o 503/429/404 -&gt; reintento&#10;con backoff, ver hallazgos)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1165" y="488" as="sourcePoint" /><mxPoint x="945" y="488" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e24" value="8. Valida con Zod y guarda&#10;extracted_data (status: completed)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="546" as="sourcePoint" /><mxPoint x="705" y="546" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e25" value="9. OK" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="945" y="604" as="sourcePoint" /><mxPoint x="305" y="604" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e26" value="10. Navega a revision de&#10;Perfil (prellenada)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="305" y="662" as="sourcePoint" /><mxPoint x="1365" y="662" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e27" value="11. Revisa/edita y confirma&#10;'Guardar y continuar'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="720" as="sourcePoint" /><mxPoint x="1365" y="720" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e28" value="12. Actualiza 'profiles'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="778" as="sourcePoint" /><mxPoint x="705" y="778" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e29" value="13. En Hoja de Vida: marca&#10;items a incluir y confirma 'Guardar'" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="836" as="sourcePoint" /><mxPoint x="1365" y="836" as="targetPoint" /></mxGeometry></mxCell><mxCell id="e30" value="14. Inserta cada item marcado&#10;de forma independiente (un fallo&#10;no bloquea ni duplica el resto)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;endArrow=block;elbow=vertical;align=center;labelBackgroundColor=#ffffff;strokeColor=#333333;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1365" y="894" as="sourcePoint" /><mxPoint x="705" y="894" as="targetPoint" /></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Vista comportamental - Actividad Autocompletado" id="page6"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1300" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="n3" value="Inicio" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="400" y="20" width="120" height="40" as="geometry" /></mxCell><mxCell id="n4" value="Usuario abre un formulario&#10;de empleo en una plataforma externa" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1"><mxGeometry x="300" y="110" width="320" height="60" as="geometry" /></mxCell><mxCell id="n5" value="EXTENSION DE NAVEGADOR&#10;(detecta los campos, identifica que piden&#10;y busca/propone el dato del perfil)&#10;&#10;[recuadro pendiente de llenar con el&#10;diseño real del compañero a cargo]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#B7791F;strokeColor=#7a4f10;fontColor=#ffffff;fontSize=11;arcSize=6;align=center;verticalAlign=middle;spacingLeft=8;spacingRight=8;spacingTop=4;spacingBottom=4;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeo